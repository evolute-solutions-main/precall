<script>\
(function()\{\
  // Lazy-load iframes\
  var hero = document.getElementById('hero-embed');\
  function init()\{\
    var q = document.querySelectorAll('.q');\
    for(var i = 0; i < q.length; i++) \{\
      q[i].src = q[i].getAttribute('data-src');\
    \}\
  \}\
  if(hero && hero.complete) init();\
  else if(hero) hero.onload = init;\
\
  // Height adjustment from iClosed\
  window.addEventListener('message', function(e)\{\
    if(e.origin.indexOf('iclosed.io') === -1) return;\
    var d = e.data;\
    if(d && d.height)\{\
      var frames = document.querySelectorAll('.embed-widget');\
      for(var j = 0; j < frames.length; j++)\{\
        if(frames[j].contentWindow === e.source)\{\
          frames[j].style.height = d.height + 'px';\
          break;\
        \}\
      \}\
    \}\
  \});\
\
  // Force top-level redirect when iClosed signals completion\
  function forceRedirect(url) \{\
    if (!url || typeof url !== 'string' || !url.startsWith('http')) return;\
    console.log('[iClosed Redirect] Forcing top window to:', url);\
    try \{ window.top.location.href = url; \} catch(e) \{ console.warn(e); \}\
    try \{ window.parent.location.href = url; \} catch(e) \{ console.warn(e); \}\
    window.location.href = url; // fallback\
  \}\
\
  window.addEventListener('message', function(event) \{\
    if (!event.origin || event.origin.indexOf('iclosed.io') === -1) return;\
\
    var data = event.data || \{\};\
    console.log('[iClosed postMessage received]', data); // \uc0\u8592  Check this in browser console during test\
\
    // Try common redirect fields\
    if (data.redirect)               forceRedirect(data.redirect);\
    if (data.redirectUrl)            forceRedirect(data.redirectUrl);\
    if (data.url)                    forceRedirect(data.url);\
    if (data.confirmationUrl)        forceRedirect(data.confirmationUrl);\
    if (data.thankYouUrl)            forceRedirect(data.thankYouUrl);\
\
    // Booking success/completion signals\
    if (data.type === 'booking_completed' || data.type === 'booking_confirmed' ||\
        data.event === 'booking_completed' || data.status === 'success' || data.success) \{\
      if (data.redirectUrl || data.url || data.confirmationUrl || data.redirect) \{\
        forceRedirect(data.redirectUrl || data.url || data.confirmationUrl || data.redirect);\
      \}\
    \}\
\
    // Last resort: scan for any http URL that looks like a confirmation page\
    for (var key in data) \{\
      if (typeof data[key] === 'string' && data[key].startsWith('http') &&\
          (data[key].includes('thank') || data[key].includes('confirm') || data[key].includes('success') || data[key].includes('booking'))) \{\
        forceRedirect(data[key]);\
      \}\
    \}\
  \}, false);\
\})();\
</script>\
